{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "SignUpBreeze Docs",
  "description": "Learn how to create events, manage volunteer signups, and get the most out of SignUpBreeze.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Changelog",
          "icon": "scroll-text",
          "href": "/changelog"
        },
        {
          "anchor": "SignUpBreeze.com",
          "icon": "external-link",
          "href": "https://signupbreeze.com"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting Started",
        "icon": "rocket",
        "pages": [
          "getting-started/introduction",
          "getting-started/key-concepts",
          "getting-started/quickstart"
        ]
      },
      {
        "group": "Organizer Guide",
        "icon": "clipboard-list",
        "pages": [
          "organizers/creating-events",
          "organizers/managing-shifts",
          "organizers/managing-signups",
          "organizers/sharing-events",
          "organizers/teams"
        ]
      },
      {
        "group": "Volunteer Guide",
        "icon": "hand-helping",
        "pages": [
          "volunteers/signing-up",
          "volunteers/magic-links",
          "volunteers/managing-registrations"
        ]
      },
      {
        "group": "Account & Settings",
        "icon": "settings",
        "pages": [
          "account/profile",
          "account/security",
          "account/appearance",
          "account/notifications"
        ]
      },
      {
        "group": "Changelog",
        "icon": "scroll-text",
        "pages": [
          "changelog"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/signupbreeze-logo-light.png",
    "dark": "/logo/signupbreeze-logo-dark.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://signupbreeze.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/SignUpBreeze",
      "linkedin": "https://www.linkedin.com/company/signupbreeze",
      "instagram": "https://www.instagram.com/signupbreeze/"
    }
  }
}
